# Configuration template; scripts read exported environment variables.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
# Tried in order when a model is unavailable, rate-limited, or times out.
# An empty value disables fallback. Omit this setting to use the defaults below.
LLM_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_API_KEY=
